# FunPop Dashboard — secrets template
# =====================================================================
# Copy this file to `.streamlit/secrets.toml` for local runs, and paste
# the same contents into Streamlit Community Cloud under
# Advanced settings → Secrets for production.
#
# .streamlit/secrets.toml is gitignored — NEVER commit the filled-in file
# or the raw service-account JSON. This .example file (no real values) is
# the only secrets file that belongs in git.
# =====================================================================

# ── Google service-account credentials ──────────────────────────────
# The ENTIRE service-account JSON, as one string. The app runs
# json.loads() on it, and derives the GCP project from the JSON's own
# "project_id" field — so there is no separate project setting.
#
# The service account only needs READ access to BigQuery:
#   • BigQuery Data Viewer  (on the project holding the BI Link dataset)
#   • BigQuery Job User     (on the same project)
#
# Paste the JSON between the triple quotes exactly as downloaded from
# GCP. Keep the private_key's \n sequences intact — a mangled key is the
# #1 first-run failure (google.auth.exceptions.RefreshError).
gcp_service_account_json = """
{
  "type": "service_account",
  "project_id": "your-gcp-project-id",
  "private_key_id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
  "private_key": "-----BEGIN PRIVATE KEY-----\nMIIE...REPLACE_ME...==\n-----END PRIVATE KEY-----\n",
  "client_email": "dashboard-reader@your-gcp-project-id.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/dashboard-reader%40your-gcp-project-id.iam.gserviceaccount.com"
}
"""

# ── BigQuery dataset ────────────────────────────────────────────────
[bigquery]
# The dataset that holds your loaded Walmart BI Link feed tables.
dataset = "dv_supplier"

# Optional. Pin the daily demand-forecast table to skip runtime
# discovery (forecast_source.py). Leave commented out to auto-discover
# it from INFORMATION_SCHEMA by its forecast columns.
# forecast_table = "your_daily_forecast_table"

# ── Optional: private-repo snapshot downloads ───────────────────────
# The app reads the durable snapshot from the `snapshot-data` branch's
# raw GitHub URL. That's fine for a PUBLIC repo. If you make the repo
# PRIVATE, raw-URL fetches need a token — set one here (a fine-grained
# PAT with read-only Contents access to the repo) so the snapshot still
# loads without a code change. Public repo: leave this unset.
# snapshot_remote_token = "github_pat_xxxxxxxxxxxxxxxxxxxx"
